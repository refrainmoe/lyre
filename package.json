{
  "name": "@refrain-lyre/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "build": "tsc --build && pnpm -r build",
    "test": "pnpm -r test",
    "release:check": "node tools/check-packages.mjs",
    "stats:check": "node tools/check-stats.mjs",
    "stats:write": "pnpm --filter @refrain-lyre/validate build && node tools/check-stats.mjs --write",
    "example:soraya": "node tools/import-soraya.mjs",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "license": "Unlicense"
}
