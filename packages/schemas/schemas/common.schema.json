{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refrain.moe/lyre/schemas/0.1/common.schema.json",
  "title": "Lyre shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 128
    },
    "paramId": {
      "type": "string",
      "pattern": "^(Lyre\\.[A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9_]*)$",
      "maxLength": 128
    },
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
