{
  "name": "@refrain-lyre/validate",
  "version": "0.1.0",
  "license": "Unlicense",
  "description": "lyre-validate — Lyrical Refrain (Lyre) model validator and conformance runner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refrainmoe/lyre.git",
    "directory": "packages/validate"
  },
  "homepage": "https://github.com/refrainmoe/lyre/tree/master/packages/validate#readme",
  "bugs": {
    "url": "https://github.com/refrainmoe/lyre/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "lyre-validate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsup && tsc --build --force",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../tools/prepublish.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@refrain-lyre/render-soft": "workspace:*",
    "@refrain-lyre/schemas": "workspace:*",
    "ajv": "^8.20.0",
    "pngjs": "^7.0.0",
    "yauzl": "^3.2.0"
  },
  "peerDependencies": {
    "@refrain-lyre/core": "^0.1.0"
  },
  "devDependencies": {
    "@refrain-lyre/core": "workspace:*",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0",
    "yazl": "^3.3.1"
  }
}
